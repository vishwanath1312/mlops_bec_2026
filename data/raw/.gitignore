# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# ── MLflow ────────────────────────────────────────────────────────────
mlruns/
mlartifacts/

# ── DVC ───────────────────────────────────────────────────────────────
/data/raw/*.csv
!/data/raw/.gitkeep
.dvc/cache/
.dvc/tmp/

# ── Models & Metrics (tracked by DVC, not Git) ──────────────────────────
models/*.pkl
!models/.gitkeep

# ── Monitoring reports ───────────────────────────────────────────────
monitoring/reports/*.html
!monitoring/reports/.gitkeep

# ── Environment & secrets ─────────────────────────────────────────────
.env
.env.*
*.pem

# ── OS / Editor ───────────────────────────────────────────────────────
.DS_Store
.vscode/
.idea/
*.log